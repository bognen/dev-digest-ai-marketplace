{
  "description": "Write guards for spec-creator (specs folder only) and implementation-planner (*-plan.md only). Each script exits 0 for every other agent.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/spec-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
