---
// One What's New entry. Full: a timeline row (date, change, mini card, notes).
// Compact: a cell in the homepage strip.
import MiniCard from './MiniCard.astro';
import { CHANGE_LABELS, CHANGE_TAGS, TYPE_LABELS, formatShortDate, getSiteData } from '../lib/data.mjs';

interface Props {
  entry: any;
  compact?: boolean;
}
const { entry, compact = false } = Astro.props;
const idName = (id: string) => id.split('/').slice(1).join(' ').replace(/^(\w+) /, '$1: ');
const version =
  entry.kind === 'updated' && entry.toVersion
    ? `${entry.fromVersion ?? '—'} → ${entry.toVersion}`
    : entry.kind === 'new' && entry.toVersion
      ? `v${entry.toVersion}`
      : null;
const includes = entry.includes ?? [];
const changed = entry.changed ?? [];

// Compact cells need the live artifact for their link and install button.
const { catalog } = getSiteData();
const artifact = compact && entry.kind !== 'removed' ? catalog.artifacts.find((a) => a.id === entry.artifactId) : null;
const href = artifact?.sourceUrl;
---
{compact ? (
  <li class:list={['cell', { removed: entry.kind === 'removed' }]} data-change data-kind={entry.kind} data-type={entry.type} data-plugin={entry.plugin}>
    <div class="cell-top"><span class={`tag ${CHANGE_TAGS[entry.kind]}`}>{CHANGE_LABELS[entry.kind]}</span><time datetime={entry.date}>{formatShortDate(entry.date)}</time></div>
    <h3 class="cell-name">{href ? <a href={href}>{entry.title || entry.name}</a> : <span>{entry.title || entry.name}</span>}</h3>
    <span class="cell-meta">{TYPE_LABELS[entry.type] ?? entry.type}{entry.type !== 'plugin' && ` · ${entry.plugin}`}</span>
    {version && <span class="cell-ver">{version}</span>}
    {artifact && (
      <button type="button" class="btn btn-ghost cell-install" data-open-onboarding data-plugin={entry.plugin} aria-label={`Install ${entry.plugin}`}>Install</button>
    )}
  </li>
) : (
  <li class="row" data-change data-kind={entry.kind} data-type={entry.type} data-plugin={entry.plugin}>
    <span class="row-date"><time datetime={entry.date}>{formatShortDate(entry.date)}</time></span>
    <span class="row-kind"><span class={`tag ${CHANGE_TAGS[entry.kind]}`}>{CHANGE_LABELS[entry.kind]}</span></span>
    <div class="row-card">
      <MiniCard
        artifactId={entry.artifactId}
        type={entry.type}
        name={entry.name}
        title={entry.title}
        plugin={entry.plugin}
        removed={entry.kind === 'removed'}
      />
    </div>
    <div class="row-notes">
      {version && <span class="row-ver">{version}</span>}
      {entry.note && <p class="note">{entry.note}</p>}
      {!entry.note && entry.description && <p class="note">{entry.description}</p>}
      {includes.length > 0 && (
        <p class="sub">Includes {includes.length} component{includes.length === 1 ? '' : 's'}: {includes.map(idName).join(', ')}</p>
      )}
      {changed.length > 0 && <p class="sub">Changed: {changed.map(idName).join(', ')}</p>}
    </div>
  </li>
)}

<style>
  /* Timeline row */
  .row {
    list-style: none; display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center;
    padding: 14px 0; border-bottom: 1px solid var(--color-divider);
  }
  .row-date { width: 52px; font-family: var(--font-mono); font-size: 12px; color: var(--faint); }
  .row-kind { width: 96px; }
  .row-card { flex: 0 1 280px; min-width: min(220px, 100%); }
  .row-notes { flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .row-ver { font-family: var(--font-mono); font-size: 13px; }
  .note { margin: 0; font-size: 14px; color: var(--muted); overflow-wrap: anywhere; }
  .sub { margin: 0; font-size: 13px; color: var(--faint); overflow-wrap: anywhere; }

  /* Strip cell */
  .cell {
    list-style: none; padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px;
    background: var(--color-bg); min-width: 0; transition: background-color .15s;
  }
  .cell:hover { background: var(--color-surface); }
  .cell-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .cell-top time { font-family: var(--font-mono); font-size: 11px; color: var(--faint); }
  .cell-name { margin: 0; font-size: 21px; line-height: 1.15; letter-spacing: 0; overflow-wrap: anywhere; }
  .cell-name a { color: var(--color-text); text-decoration: none; }
  .cell-name a:hover { color: var(--accent-text); text-decoration: underline; }
  .removed .cell-name { text-decoration: line-through; }
  .cell-meta { font-size: 13px; color: var(--muted); }
  .cell-ver { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .cell-install { align-self: flex-start; height: 28px; margin: auto 0 0 -4px; font-size: 13px; }
</style>
