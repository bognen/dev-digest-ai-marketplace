---
// A command or snippet with a copy button. Extra attributes go on <pre>,
// so scripts can rewrite the command (e.g. contextual install commands).
// With `filename`, it renders as a file block with the name in a header row.
interface Props {
  command: string;
  label?: string;
  filename?: string;
  [attr: string]: unknown;
}
const { command, label = 'command', filename, ...attrs } = Astro.props;
---
{filename ? (
  <div class="cmd cmd-file">
    <div class="cmd-file-head">
      <span>{filename}</span>
      <button type="button" class="btn btn-ghost copy-btn" data-copy aria-label={`Copy ${label}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>
    <pre {...attrs}><code>{command}</code></pre>
  </div>
) : (
  <div class="cmd">
    <pre {...attrs}><code>{command}</code></pre>
    <button type="button" class="btn btn-ghost copy-btn" data-copy aria-label={`Copy ${label}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
      <span data-copy-label>Copy</span>
    </button>
  </div>
)}

<script>
  import '../scripts/copy.js';
</script>
