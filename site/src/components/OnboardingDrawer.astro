---
// Onboarding as a side panel (bottom drawer below 768px). Opened by any
// element with [data-open-onboarding]; [data-plugin] switches on contextual mode.
import Onboarding from './Onboarding.astro';
import { url } from '../lib/data.mjs';
---
<dialog class="drawer" data-onboarding-drawer aria-labelledby="drawer-title">
  <div class="drawer-inner">
    <header class="drawer-head">
      <div class="drawer-titles">
        <p class="kicker" data-drawer-kicker>Get started</p>
        <h2 id="drawer-title" data-drawer-title>Connect the marketplace</h2>
      </div>
      <button type="button" class="btn btn-secondary btn-icon" data-close-drawer aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
      </button>
    </header>
    <Onboarding idPrefix="drawer" headingLevel="h3" />
    <p class="drawer-foot"><a href={url('get-started')} data-full-guide>Open the full guide →</a></p>
  </div>
</dialog>

<style>
  .drawer {
    padding: 0; border: 0; border-left: 1px solid var(--color-divider); margin: 0 0 0 auto;
    height: 100dvh; max-height: 100dvh; width: min(560px, 100vw); max-width: 100vw;
    background: var(--color-bg); color: var(--color-text); box-shadow: var(--shadow-lg);
    overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain;
  }
  .drawer::backdrop { background: var(--backdrop); }
  .drawer-inner { display: flex; flex-direction: column; gap: 18px; padding: 24px 28px 40px; min-width: 0; }
  .drawer-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .drawer-titles { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .drawer-head h2 { margin: 0; font-size: 30px; line-height: 1.05; overflow-wrap: anywhere; }
  .drawer-head .btn { flex: none; }
  .drawer-foot { margin: 0; font-size: 14px; }

  @media (max-width: 767px) {
    .drawer {
      margin: auto 0 0; width: 100vw; height: 92dvh; max-height: 92dvh;
      border-left: 0; border-top: 1px solid var(--color-divider);
    }
    .drawer-inner { padding: 20px 16px 32px; }
  }
</style>

<script>
  const drawer = document.querySelector<HTMLDialogElement>('[data-onboarding-drawer]');

  document.addEventListener('click', (event) => {
    const opener = (event.target as HTMLElement).closest<HTMLElement>('[data-open-onboarding]');
    if (opener) {
      event.preventDefault();
      const plugin = opener.dataset.plugin ?? null;
      const guide = document.querySelector<HTMLElement>('[data-onboarding][data-from-query]');
      if (guide) {
        // On /get-started the guide is already on the page.
        guide.dispatchEvent(new CustomEvent('ddm:context', { detail: { plugin } }));
        guide.querySelector(plugin ? '[data-step="install"]' : '[data-step="prereq"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      if (!drawer) return;
      drawer.querySelector('[data-onboarding]')!.dispatchEvent(new CustomEvent('ddm:context', { detail: { plugin } }));
      drawer.querySelector('[data-drawer-kicker]')!.textContent = plugin ? 'Install' : 'Get started';
      drawer.querySelector('[data-drawer-title]')!.textContent = plugin ? `Install ${plugin}` : 'Connect the marketplace';
      const full = drawer.querySelector<HTMLAnchorElement>('[data-full-guide]')!;
      const base = full.getAttribute('href')!.split('?')[0];
      full.href = plugin ? `${base}?plugin=${encodeURIComponent(plugin)}` : base;
      drawer.showModal();
      if (plugin) drawer.querySelector('[data-step="install"]')?.scrollIntoView({ block: 'start' });
      return;
    }
    if (!drawer) return;
    if ((event.target as HTMLElement).closest('[data-close-drawer]') || event.target === drawer) drawer.close();
  });
</script>
