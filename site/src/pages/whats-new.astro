---
import Base from '../layouts/Base.astro';
import ChangeEntry from '../components/ChangeEntry.astro';
import { CHANGE_LABELS, TYPE_LABELS, formatShortDate, getSiteData, url } from '../lib/data.mjs';

const { changes, catalog } = getSiteData();
const entries = changes.entries;

// Group by week (weeks start on Monday, UTC).
const weekStart = (iso: string) => {
  const d = new Date(iso);
  const day = (d.getUTCDay() + 6) % 7;
  return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() - day)).toISOString();
};
const weeks: { start: string; entries: typeof entries }[] = [];
for (const entry of entries) {
  const start = weekStart(entry.date);
  if (weeks.at(-1)?.start !== start) weeks.push({ start, entries: [] });
  weeks.at(-1)!.entries.push(entry);
}
const countLabel = (n: number) => `${n} change${n === 1 ? '' : 's'}`;

const kinds = Object.keys(CHANGE_LABELS);
const types = [...new Set(entries.map((e) => e.type))];
const plugins = [...new Set(entries.map((e) => e.plugin))].sort();
const repo = catalog.marketplace.repo;
---
<Base title="What's new" description="New, updated and deprecated plugins, skills and agents">
  <div class="container wn">
    <header class="page-head">
      <h1>What's new</h1>
      <p>Every change to the catalog, from git history and plugin versions. Rebuilt on every merge to main.</p>
    </header>

    {entries.length > 0 ? (
      <>
        <form class="filters" data-filters aria-label="Filter changes">
          <div class="seg" role="radiogroup" aria-label="Change type">
            <label class="seg-opt"><input type="radio" name="change" value="" checked />All</label>
            {kinds.map((k) => <label class="seg-opt"><input type="radio" name="change" value={k} />{CHANGE_LABELS[k]}</label>)}
          </div>
          <select class="input" name="type" aria-label="Artifact type">
            <option value="">All types</option>
            {types.map((t) => <option value={t}>{TYPE_LABELS[t] ?? t}</option>)}
          </select>
          <select class="input" name="plugin" aria-label="Plugin">
            <option value="">All plugins</option>
            {plugins.map((p) => <option value={p}>{p}</option>)}
          </select>
          <p class="result-count" data-result-count aria-live="polite">{countLabel(entries.length)}</p>
        </form>

        <div class="empty-filtered" data-filter-empty hidden>
          <p>No changes match these filters. <button type="button" class="btn btn-ghost" data-clear-filters>Clear filters</button></p>
        </div>

        {weeks.map((week) => (
          <section class="week" data-week aria-labelledby={`week-${week.start.slice(0, 10)}`}>
            <div class="week-head">
              <h2 id={`week-${week.start.slice(0, 10)}`}>Week of {formatShortDate(week.start)}</h2>
              <span data-week-count>{countLabel(week.entries.length)}</span>
            </div>
            <ol class="week-list">
              {week.entries.map((entry) => <ChangeEntry entry={entry} />)}
            </ol>
          </section>
        ))}
      </>
    ) : (
      <div class="empty">
        <p><strong>Nothing has been published yet.</strong></p>
        <p>
          New plugins, version updates and deprecations appear here as soon as they're merged into <code>main</code>.
          {repo && <> Want to add one? Read the <a href={`https://github.com/${repo}/blob/main/CONTRIBUTING.md`}>contribution guide</a>.</>}
        </p>
        <p><a class="btn btn-secondary" href={url('get-started')}>Connect the marketplace</a></p>
      </div>
    )}
  </div>
</Base>

<style>
  .wn { padding-bottom: 88px; }
  .filters {
    display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; padding: 10px 0;
    border-top: 1px solid var(--color-divider); border-bottom: 1px solid var(--color-divider);
  }
  .seg { flex-wrap: wrap; }
  .seg-opt { height: 34px; padding: 0 12px; font-family: var(--font-heading); font-weight: 600; font-size: 14px; position: relative; }
  .seg-opt:has(input:checked) { background: var(--accent-fill); color: var(--color-bg); }
  .seg-opt:not(:has(input:checked)):hover { background: var(--hover); }
  .filters select { width: auto; min-height: 36px; max-width: 100%; }
  .result-count { margin: 0 0 0 auto; font-size: 14px; color: var(--muted); }
  .empty-filtered { padding: 40px 0; color: var(--muted); }
  .empty-filtered p { margin: 0; }

  .week { padding-top: 36px; display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 16px 40px; align-items: start; }
  .week-head { display: flex; flex-direction: column; gap: 2px; position: sticky; top: 76px; }
  .week-head h2 { margin: 0; font-size: 22px; }
  .week-head span { font-size: 13px; color: var(--faint); }
  .week-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-divider); min-width: 0; }

  @media (max-width: 767px) {
    .week { grid-template-columns: minmax(0, 1fr); }
    .week-head { position: static; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  if (form) {
    const names = ['change', 'type', 'plugin'];
    const field = (name: string) => form.elements.namedItem(name) as HTMLSelectElement | RadioNodeList;
    const values = (name: string) => [...(field(name) instanceof RadioNodeList ? field(name) : (field(name) as HTMLSelectElement).options)].map((el: any) => el.value);
    const count = form.querySelector<HTMLElement>('[data-result-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]')!;
    const attr: Record<string, string> = { change: 'kind', type: 'type', plugin: 'plugin' };
    const label = (n: number) => `${n} change${n === 1 ? '' : 's'}`;
    // RadioNodeList.value = '' doesn't check the radio whose value is empty, so set radios directly.
    const setValue = (name: string, v: string) => {
      const f = field(name);
      if (f instanceof RadioNodeList) f.forEach((r) => ((r as HTMLInputElement).checked = (r as HTMLInputElement).value === v));
      else f.value = v;
    };

    // Restore filters from the URL so a filtered view can be shared.
    const params = new URLSearchParams(location.search);
    for (const name of names) {
      const v = params.get(name);
      if (v && values(name).includes(v)) setValue(name, v);
    }

    const apply = () => {
      const current = Object.fromEntries(names.map((name) => [name, field(name).value]));
      let shown = 0;
      document.querySelectorAll<HTMLElement>('[data-change]').forEach((li) => {
        const match = names.every((name) => !current[name] || li.dataset[attr[name]] === current[name]);
        li.hidden = !match;
        if (match) shown++;
      });
      document.querySelectorAll<HTMLElement>('[data-week]').forEach((week) => {
        const visible = week.querySelectorAll('[data-change]:not([hidden])').length;
        week.hidden = !visible;
        week.querySelector('[data-week-count]')!.textContent = label(visible);
      });
      count.textContent = label(shown);
      empty.hidden = shown > 0;

      const next = new URLSearchParams();
      for (const name of names) if (current[name]) next.set(name, current[name]);
      const qs = next.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };

    form.addEventListener('change', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    document.querySelector('[data-clear-filters]')?.addEventListener('click', () => {
      names.forEach((name) => setValue(name, ''));
      apply();
    });
    apply();
  }
</script>
