---
import Base from '../layouts/Base.astro';
import Onboarding from '../components/Onboarding.astro';
import { getSiteData, url } from '../lib/data.mjs';

const { catalog } = getSiteData();
---
<Base title="Get started" description={`How to connect the ${catalog.marketplace.name} marketplace to Claude Code`} drawer={false}>
  <div class="container start-layout">
    <div class="start-main">
      <header class="start-head">
        <p class="kicker">Get started</p>
        <h1>Connect the marketplace</h1>
        <p>About three minutes. Pick where you use Claude Code; the steps are the same. Tick each step as you go — progress is saved in this browser.</p>
      </header>
      <Onboarding idPrefix="page" fromQuery />
    </div>

    <aside class="start-aside" aria-label="More">
      <div class="blueprint aside-card">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <h2>Prefer the terminal?</h2>
        <p>Install <code>find-skill</code> and ask Claude Code to recommend artifacts from this catalog without leaving your session.</p>
        <p class="soon">Coming in phase 2</p>
      </div>
      <nav class="next" aria-labelledby="next-title">
        <h2 id="next-title">Next</h2>
        <a href={url('whats-new')}>See what's new<span aria-hidden="true">→</span></a>
        <a href={url()}>Back to the catalog<span aria-hidden="true">→</span></a>
      </nav>
    </aside>
  </div>
</Base>

<style>
  .start-layout { display: flex; flex-wrap: wrap; gap: 56px; padding-top: 40px; padding-bottom: 88px; align-items: flex-start; }
  .start-main { flex: 1 1 600px; min-width: 0; max-width: 780px; display: flex; flex-direction: column; gap: 24px; }
  .start-head { display: flex; flex-direction: column; gap: 10px; }
  .start-head h1 { margin: 0; font-size: clamp(34px, 5vw, 52px); line-height: 1.02; letter-spacing: -0.02em; }
  .start-head p:last-child { margin: 0; color: var(--muted); font-size: 17px; text-wrap: pretty; }
  .start-aside { flex: 1 1 260px; max-width: 340px; display: flex; flex-direction: column; gap: 20px; position: sticky; top: 84px; }
  .aside-card { padding: 18px 20px; display: flex; flex-direction: column; gap: 10px; }
  .aside-card h2 { margin: 0; font-size: 20px; }
  .aside-card p { margin: 0; font-size: 14px; color: var(--muted); }
  .aside-card code { color: var(--color-text); }
  .aside-card .soon { color: var(--faint); }
  .next { display: flex; flex-direction: column; }
  .next h2 { margin: 0 0 6px; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .next a {
    display: flex; justify-content: space-between; min-height: 40px; align-items: center;
    border-bottom: 1px solid var(--color-divider); color: var(--color-text); text-decoration: none;
  }
  .next a:hover { color: var(--accent-text); }
  @media (max-width: 939px) {
    .start-aside { position: static; max-width: none; }
  }
  @media (max-width: 480px) {
    .start-layout { padding-top: 28px; gap: 40px; }
  }
</style>
