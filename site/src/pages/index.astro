---
import Base from '../layouts/Base.astro';
import StartCard from '../components/StartCard.astro';
import WhatsNewStrip from '../components/WhatsNewStrip.astro';
import { getSiteData } from '../lib/data.mjs';

const { catalog } = getSiteData();
---
<Base>
  <div class="container home">
    <StartCard />

    <!-- Shown instead of the Start card once it is dismissed. -->
    <section class="collapsed-hero" aria-labelledby="home-title">
      <h1 id="home-title">Claude Code plugins, skills and agents</h1>
      <p>{catalog.marketplace.description || 'A curated Claude Code plugin marketplace.'}</p>
      <button type="button" class="getting-started" data-show-start>New here? Getting started →</button>
    </section>

    <WhatsNewStrip />
  </div>
</Base>

<style>
  .home { padding-bottom: 88px; }
  .collapsed-hero { display: none; padding-top: 48px; flex-direction: column; gap: 10px; }
  :global(html[data-start-dismissed]) .collapsed-hero { display: flex; }
  .collapsed-hero h1 { margin: 0; font-size: clamp(30px, 4vw, 42px); line-height: 1.05; letter-spacing: -0.02em; }
  .collapsed-hero p { margin: 0; color: var(--muted); font-size: 17px; max-width: 640px; }
  .getting-started {
    align-self: flex-start; padding: 0; border: 0; background: none; cursor: pointer;
    color: var(--accent-text); font: inherit; font-size: 14px; text-decoration: underline; text-underline-offset: 3px;
  }
  .getting-started:hover { color: var(--color-accent-700); }
</style>
