---
import Base from '../layouts/Base.astro';
import { url } from '../lib/data.mjs';
---
<Base title="Page not found">
  <div class="container">
    <div class="nf">
      <p class="nf-path" data-not-found-path>404</p>
      <h1>This page isn't in the catalog.</h1>
      <p class="nf-lead">It may have been renamed or removed. Search for what you need instead.</p>
      <button type="button" class="nf-search" data-not-found-search>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
        <span>Search the marketplace</span>
        <kbd aria-hidden="true">/</kbd>
      </button>
      <div class="nf-links">
        <a class="btn btn-secondary" href={url()}>Home</a>
        <a class="btn btn-secondary" href={url('whats-new')}>What's new</a>
        <a class="btn btn-secondary" href={url('get-started')}>Get started</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .nf { min-height: 60vh; display: flex; flex-direction: column; justify-content: center; gap: 18px; max-width: 720px; padding: 48px 0; }
  .nf-path { margin: 0; font-family: var(--font-mono); font-size: 14px; color: var(--accent-text); overflow-wrap: anywhere; }
  h1 { margin: 0; font-size: clamp(36px, 6vw, 64px); line-height: 1; letter-spacing: -0.02em; text-wrap: balance; }
  .nf-lead { margin: 0; color: var(--muted); font-size: 17px; }
  .nf-search {
    display: flex; align-items: center; gap: 12px; min-height: 54px; padding: 0 16px; width: 100%;
    background: var(--color-surface); border: 1px solid var(--color-accent); cursor: text;
    color: var(--muted); font: inherit; font-size: 17px; text-align: left;
  }
  .nf-search svg { flex: none; color: var(--accent-text); }
  .nf-search span { flex: 1; }
  .nf-search:hover { border-color: var(--color-accent-700); }
  .nf-links { display: flex; gap: 10px; flex-wrap: wrap; }
</style>

<script>
  const path = document.querySelector('[data-not-found-path]');
  if (path) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    let shown = location.pathname.startsWith(base) ? location.pathname.slice(base.length) || '/' : location.pathname;
    try { shown = decodeURIComponent(shown); } catch { /* keep it encoded */ }
    path.textContent = `404 · ${shown}`;
  }

  // The design shows a search box here; it hands off to the header search,
  // which already has the catalog and the type-ahead.
  document.querySelector('[data-not-found-search]')?.addEventListener('click', () => {
    const input = document.querySelector<HTMLInputElement>('#site-search');
    if (!input) return;
    if (!input.offsetParent) document.querySelector<HTMLButtonElement>('[data-search-toggle]')?.click();
    window.scrollTo({ top: 0 });
    input.focus();
  });
</script>
